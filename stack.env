# Google OAuth 2.0 Client ID (Get one from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# JWT Secret Key for signing backend session tokens (use a random string)
JWT_SECRET=super-secret-manga-reader-token-key-2026

# Database configuration settings for the production containers
DB_USER=reader_user
DB_PASSWORD=reader_secure_password
DB_NAME=reader_db
