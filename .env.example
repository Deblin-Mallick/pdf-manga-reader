# Google OAuth 2.0 Client ID (Get one from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# JWT Secret Key for signing backend session tokens (use a random string)
JWT_SECRET=generate-a-secure-random-string-here

# Database connection URL (Default fallback is SQLite reader.db if not defined or local development)
# DATABASE_URL=postgresql://reader_user:reader_password@localhost:5432/reader_db

# Optional database customization variables for Docker Compose containers
# DB_USER=reader_user
# DB_PASSWORD=reader_password
# DB_NAME=reader_db
