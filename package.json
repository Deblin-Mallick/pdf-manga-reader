{
  "name": "pdf-manga-reader-monorepo",
  "version": "1.0.0",
  "description": "Monorepo for PDF and Manga Reader with FastAPI backend",
  "scripts": {
    "install:frontend": "cd frontend && npm install",
    "dev": "concurrently \"npm run dev --prefix frontend\" \"cd backend && python3 -m uvicorn app.main:app --reload --port 8000\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server-sequential-thinking": "^2025.12.18",
    "@subframe/core": "^1.155.0"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deblin-Mallick/pdf-manga-reader.git"
  },
  "keywords": [],
  "author": "Deblin Mallick",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Deblin-Mallick/pdf-manga-reader/issues"
  },
  "homepage": "https://github.com/Deblin-Mallick/pdf-manga-reader#readme"
}
